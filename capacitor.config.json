{
  "appId": "co.barberiahermanos.barberos",
  "appName": "Barbería Hermanos",
  "webDir": "dist-app",
  "backgroundColor": "#111111",
  "plugins": {
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#111111",
      "overlaysWebView": false
    },
    "SystemBars": {
      "insetsHandling": "css",
      "style": "DARK"
    },
    "CapacitorUpdater": {
      "autoUpdate": false,
      "appReadyTimeout": 15000,
      "autoDeleteFailed": true,
      "autoDeletePrevious": true
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  }
}
